{
	"steps": [
		{
			"name": "an edit of a module only the \"*\" pattern resolves",
			"do": [{ "patch": { "file": "src/shared/mod.ts", "find": "m = 1", "replace": "m = 3" } }]
		},
		{
			"name": "a new module only \"*\" resolves, imported",
			"do": [
				{ "write": { "file": "src/shared/extra.ts", "text": "export const e = 5;\n" } },
				{
					"patch": {
						"file": "src/shared/a.ts",
						"find": "export const a = m + t;",
						"replace": "import { e } from \"shared/extra\";\n\nexport const a = m + t + e;"
					}
				}
			]
		},
		{
			"name": "a paths pattern that matches the name and resolves nothing: no fallback to \"*\"",
			"do": [
				{
					"patch": {
						"file": "tsconfig.json",
						"find": "\"@lib/*\": [\"./src/lib/*\"],",
						"replace": "\"@lib/*\": [\"./src/lib/*\"], \"shared/*\": [\"./src/lib/*\"],"
					}
				}
			],
			"expect": "error"
		},
		{
			"name": "the pattern removed",
			"do": [{ "patch": { "file": "tsconfig.json", "find": " \"shared/*\": [\"./src/lib/*\"],", "replace": "" } }]
		},
		{
			"name": "baseUrl added: TS5102, TypeScript 7 removed it",
			"do": [
				{
					"patch": {
						"file": "tsconfig.json",
						"find": "\"outDir\": \"out\",",
						"replace": "\"outDir\": \"out\",\n\t\t\"baseUrl\": \"./src\","
					}
				}
			],
			"expect": "error"
		},
		{
			"name": "baseUrl removed again",
			"do": [{ "patch": { "file": "tsconfig.json", "find": "\n\t\t\"baseUrl\": \"./src\",", "replace": "" } }]
		},
		{
			"name": "the new module deleted",
			"do": [
				{ "delete": "src/shared/extra.ts" },
				{
					"patch": {
						"file": "src/shared/a.ts",
						"find": "import { e } from \"shared/extra\";\n\nexport const a = m + t + e;",
						"replace": "export const a = m + t;"
					}
				}
			]
		}
	]
}
